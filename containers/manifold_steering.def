# =====================================================================
# manifold_steering.def —— manifold-steer 项目镜像（aarch64 / GH200，Arrhenius）
#
# 自包含：不依赖任何外部文件，一条命令即可构建。
# 必须在 GPU 节点（aarch64）上构建，登录节点是 x86_64，构建出来架构不对。
#
#   export APPTAINER_CACHEDIR=/nobackup/proj/disk/naiss2025-22-1730/personal/licheng/apptainer_cache
#   export APPTAINER_TMPDIR=/nobackup/proj/disk/naiss2025-22-1730/personal/licheng/apptainer_tmp
#   apptainer build ms.sif manifold_steering.def
#
# 两个虚拟环境：
#   main   vLLM + safety-tooling + GLP 依赖 + 调试工具（默认，已在 PATH 上）
#   train  torch + transformers + peft + trl（用完整路径调用，torch 与 main 同版本）
#
#   apptainer exec --nv ms.sif python -c "import vllm"
#   apptainer exec --nv ms.sif /opt/venvs/train/bin/torchrun --standalone --nproc_per_node=4 train.py
#
# 注意：不要用环境变量切换 venv，Apptainer 处理 %environment 时读不到宿主机上临时设置的变量。
# =====================================================================
Bootstrap: docker
From: python:3.12-bookworm

%labels
    title manifold-steer
    arch aarch64-gh200

%environment
    export PYTHONNOUSERSITE=1
    export PYTHONUNBUFFERED=1
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export VIRTUAL_ENV=/opt/venvs/main
    export PATH="/opt/venvs/main/bin:${PATH}"
    # 镜像里没有 nvcc，FlashInfer 采样器会尝试现场编译而失败；改用 PyTorch 原生 top-k/top-p 采样
    export VLLM_USE_FLASHINFER_SAMPLER="${VLLM_USE_FLASHINFER_SAMPLER:-0}"

%post -c /bin/bash
set -euo pipefail

# ---------- 0. 基本设置 ----------
[[ "$(uname -m)" == "aarch64" ]] || { echo "必须在 aarch64（GH200）节点上构建"; exit 1; }
PY=/usr/local/bin/python3.12
REQ=/opt/ms/req
OUT=/opt/ms/lock-out
mkdir -p "$REQ" "$OUT" /opt/venvs
export UV_CACHE_DIR=/opt/uv-cache UV_PYTHON_DOWNLOADS=never UV_LINK_MODE=copy UV_HTTP_TIMEOUT=600 UV_NO_PROGRESS=1
"$PY" -m pip install --no-cache-dir --root-user-action=ignore --upgrade pip uv

# ---------- 1. 依赖清单 ----------
# aarch64 上只有 torch>=2.11 的 PyPI wheel 自带 CUDA；更老的版本是纯 CPU 版。
cat > "$REQ/constraints.txt" <<'EOF'
torch>=2.11
EOF

cat > "$REQ/main-core.in" <<'EOF'
vllm
transformers
datasets
peft
accelerate
huggingface_hub
safetensors
diffusers
omegaconf
einops
joblib
numpy
scipy
scikit-learn
pandas
pyarrow
matplotlib
baukit @ git+https://github.com/davidbau/baukit.git
anthropic
openai
wandb
pytest
ipython
ipdb
debugpy
jupyterlab
EOF

# safety-tooling 的 InferenceAPI 导入时会加载所有供应商模块，这些包都要装上（不钉版本）。
cat > "$REQ/safetytooling-deps.in" <<'EOF'
elevenlabs
google-cloud-aiplatform
google-cloud-run
google-cloud-storage
google-cloud-logging
google-api-python-client
grayswan-api
langchain
tiktoken
jsonlines
tenacity
termcolor
simple-parsing
python-dotenv
redis
pydantic
Jinja2
plotly
seaborn
pydub
soundfile
librosa
opencv-python-headless
GitPython
ipywidgets
websockets
psutil
tabulate
eval-type-backport<0.3
EOF

cat > "$REQ/train.in" <<'EOF'
torch>=2.11
transformers
peft
accelerate
datasets
trl
safetensors
diffusers
omegaconf
einops
joblib
numpy
scipy
scikit-learn
pandas
pyarrow
baukit @ git+https://github.com/davidbau/baukit.git
wandb
pytest
ipython
ipdb
EOF

# ---------- 2. main 环境 ----------
# safety-tooling 把依赖钉在旧版本，直接和 vLLM 一起解析会冲突，所以分三步。
uv venv --python "$PY" /opt/venvs/main
M=/opt/venvs/main/bin/python
uv pip install --python "$M" -r "$REQ/main-core.in" -c "$REQ/constraints.txt"
uv pip freeze --python "$M" | grep -v ' @ ' > /tmp/main-pins.txt
uv pip install --python "$M" --no-deps "safetytooling @ git+https://github.com/safety-research/safety-tooling.git"
if ! uv pip install --python "$M" -r "$REQ/safetytooling-deps.in" -c /tmp/main-pins.txt -c "$REQ/constraints.txt"; then
  echo "safety-tooling 依赖整体安装失败，逐个安装" | tee "$OUT/main-fallback.txt"
  while read -r pkg; do
    [[ -z "$pkg" ]] && continue
    uv pip install --python "$M" "$pkg" -c /tmp/main-pins.txt -c "$REQ/constraints.txt" \
      || echo "skipped: $pkg" | tee -a "$OUT/main-fallback.txt"
  done < "$REQ/safetytooling-deps.in"
fi
# 以下两类包必须用 safety-tooling 写代码时的旧版本，但它们的旧依赖和 vLLM 的环境冲突，
# 所以不带依赖安装（导入所需的依赖已在上面装好）：
#   google-generativeai 0.8.4：已停止维护，其 generativelanguage 0.6.15 要求 protobuf<6
#   together 1.5.4：新版 SDK 删除了 safety-tooling 导入的 together.error.ServiceUnavailableError
uv pip install --python "$M" --no-deps \
  "google-generativeai==0.8.4" "google-ai-generativelanguage==0.6.15" "together==1.5.4"

# ---------- 3. train 环境 ----------
# torch/torchvision 与 main 用同一版本：和驱动精确匹配，镜像打包时两份相同文件也会自动去重。
# 不装 axolotl：它的每个版本都把 torch/datasets 钉成和这里冲突的具体版本；LoRA 训练改用 trl + peft。
uv venv --python "$PY" /opt/venvs/train
T=/opt/venvs/train/bin/python
uv pip freeze --python "$M" | grep -iE '^(torch|torchvision)==' > /tmp/main-torch.txt
uv pip install --python "$T" -r "$REQ/train.in" -c "$REQ/constraints.txt" -c /tmp/main-torch.txt

# ---------- 4. 记录版本、校验、清理 ----------
uv pip freeze --python "$M" > "$OUT/requirements-main.lock.txt"
uv pip freeze --python "$T" > "$OUT/requirements-train.lock.txt"
for v in main train; do
  /opt/venvs/$v/bin/python -c "import torch, sys; assert torch.version.cuda, 'CPU-only torch in $v'; print('$v: python', sys.version.split()[0], 'torch', torch.__version__, 'cuda', torch.version.cuda)"
done
"$M" -c "import vllm; print('vllm', vllm.__version__)"
"$M" -c "from safetytooling.apis import InferenceAPI" 2>"$OUT/safetytooling-import.err" \
  && echo "safetytooling: ok" > "$OUT/optional-status.txt" \
  || echo "safetytooling: import FAILED" > "$OUT/optional-status.txt"
date -u +%Y-%m-%dT%H:%M:%SZ > "$OUT/built-at.txt"
rm -rf "$UV_CACHE_DIR" /root/.cache

%runscript
    exec "${@:-bash}"

%test
    set -e
    for v in main train; do
        /opt/venvs/$v/bin/python -c "import torch; assert torch.version.cuda; print('$v ok', torch.__version__)"
    done
    cat /opt/ms/lock-out/optional-status.txt
